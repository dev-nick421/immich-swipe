# Immich Swipe - Environment Configuration
# Copy this file to .env and fill in your values

# Built-in Immich API proxy (Docker, read at container start, no rebuild needed).
# How the immich-swipe container reaches Immich, e.g. http://immich-server:2283 or
# http://192.168.1.10:2283. Leave empty to let the browser call Immich directly
# (then Immich must send CORS headers, see README).
IMMICH_URL=

# --- Build-time values (VITE_*): baked into the frontend, rebuild after changes ---

# Your Immich server URL (as opened in the browser; used for "Open in Immich",
# and for API calls when IMMICH_URL is empty)
VITE_SERVER_URL=http://immich.home

# User 1
VITE_USER_1_NAME=User 1
VITE_USER_1_API_KEY=your-api-key-here

# User 2 (optional)
VITE_USER_2_NAME=User 2
VITE_USER_2_API_KEY=another-api-key-here

# Add more users as needed (VITE_USER_3_NAME, VITE_USER_3_API_KEY, etc.)
