# Immich Swipe - Environment Configuration
# Copy this file to .env and fill in your values

# --- Build-time values (VITE_*): baked into the frontend, rebuild after changes ---

# Your Immich URL, as you open it in the browser (e.g. https://immich.example.com or
# http://192.168.1.10:2283). The Docker image also forwards API calls to it (built-in proxy),
# so Immich needs no CORS headers.
VITE_SERVER_URL=http://immich.home

# User 1
VITE_USER_1_NAME=User 1
VITE_USER_1_API_KEY=your-api-key-here

# User 2 (optional)
VITE_USER_2_NAME=User 2
VITE_USER_2_API_KEY=another-api-key-here

# Add more users as needed (VITE_USER_3_NAME, VITE_USER_3_API_KEY, etc.)

# --- Optional, read at container start (no rebuild needed) ---

# Only if the container has to reach Immich under a different address than VITE_SERVER_URL,
# e.g. http://immich-server:2283 on Immich's Docker network, or a LAN IP when your public domain
# is not reachable from inside your network. Overrides VITE_SERVER_URL for the built-in proxy.
# IMMICH_URL=http://immich-server:2283
